# SPDX-License-Identifier: 0BSD
# Copy to ~/.config/river/nimzo.config (or $XDG_CONFIG_HOME/river/nimzo.config).

set $mod Mod4
set $term foot
set $red #8b0000
set $titlebar_border #a82020
set $white #ffffff

font pango:monospace 10
#                    border  background  text    indicator  child_border titlebar_border
client.focused       $red    $red        $white  $red       $red         $titlebar_border
client.unfocused     #500000 #500000     #dddddd #500000    #500000      #702020

# Modifier for left-button move and right-button resize.
floating_modifier $mod

# Zones use percentages of each output's usable area, excluding panels.
# Edges span the full edge; corners use one quarter; center uses 80% per axis.
layout zones
zone NW 0%  0%  50%  50%
zone N  0%  0%  100% 50%
zone NE 50% 0%  50%  50%
zone W  0%  0%  50%  100%
zone C  10% 10% 80%  80%
zone E  50% 0%  50%  100%
zone SW 0%  50% 50%  50%
zone S  0%  50% 100% 50%
zone SE 50% 50% 50%  50%

bindsym $mod+KP_Home move container to zone NW
bindsym $mod+KP_Up move container to zone N
bindsym $mod+KP_Prior move container to zone NE
bindsym $mod+KP_Left move container to zone W
bindsym $mod+KP_Begin move container to zone C
bindsym $mod+KP_Right move container to zone E
bindsym $mod+KP_End move container to zone SW
bindsym $mod+KP_Down move container to zone S
bindsym $mod+KP_Next move container to zone SE
bindsym $mod+KP_Home cycle-zone NW|W
bindsym $mod+KP_Up cycle-zone N|NW|NE
bindsym $mod+KP_Prior cycle-zone NE|E
bindsym $mod+KP_Left cycle-zone W|NW|SW
bindsym $mod+KP_Begin cycle-zone C
bindsym $mod+KP_Right cycle-zone E|NE|SE
bindsym $mod+KP_End cycle-zone SW|W
bindsym $mod+KP_Down cycle-zone S|SE|SW
bindsym $mod+KP_Next cycle-zone SE|E


# Match rules apply once at initial placement; the last matching rule wins.
# for_window [app_id="^org\.example\.Dialog$"] fixedSize on
# for_window [app_id="^org\.example\.Dialog$" title="Main"] fixedSize off

bindsym Alt+x exec $term
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f fixedSize toggle
bindsym $mod+Backslash fixedSize toggle
bindsym $mod+space exec $term
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+n focus next
bindsym $mod+Tab focus next
bindsym Alt+Tab focus next
bindsym $mod+m minimize
bindsym $mod+Shift+m restore
bindsym Ctrl+Alt+BackSpace exit
bindsym $mod+Shift+r reload

# Workspaces are shared across outputs; each output shows one workspace.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+1 move container to workspace number 1, workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2, workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3, workspace number 3
bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next
bindsym $mod+Shift+Left move container to workspace prev
bindsym $mod+Shift+Right move container to workspace next

# Directional output navigation uses the configured output positions.
bindsym $mod+KP_Subtract focus output up
bindsym $mod+KP_Add focus output down
bindsym $mod+Shift+KP_Subtract move container to output up, focus output up
bindsym $mod+Shift+KP_Add move container to output down, focus output down
bindsym $mod+Control+KP_Subtract move workspace to output up
bindsym $mod+Control+KP_Add move workspace to output down

# Optional desktop companions. Startup execs run once, not on config reload.
# See examples/waybar.jsonc and examples/waybar.css for a compatible bar setup.
# exec waybar
# exec swaybg -i "$HOME/Pictures/wallpaper.png" -m fill

# Enable these if the corresponding companion programs are installed.
# bindsym $mod+p exec bemenu-run
# bindsym Ctrl+Alt+l exec waylock
# bindsym XF86AudioLowerVolume exec volctl down
# bindsym XF86AudioRaiseVolume exec volctl up
# bindsym XF86AudioMute exec volctl toggle

# Output placement: replace these names with your actual connectors.
# output DP-3 {
#   resolution 2560x1440
#   position 0 0
# }
# output HDMI-A-1 {
#   resolution 1920x1080
#   position below DP-3 gap 1
# }
# Other directions: left-of, right-of, above. The gap is optional.
# Do not run another persistent output configurator alongside these rules.
# Outputs with no workspace patterns are unrestricted. Matching patterns are
# preferred when a workspace is created; default is the preferred fallback.
# Only one output can be default; a conflicting later declaration is rejected.
# An explicit move to an ineligible output is rejected (no silent fallback).
# Existing workspaces stay on their output across reload while it is eligible;
# disconnected or newly ineligible workspaces use an eligible fallback.
#
# Inline default and position:
# output DP-3 default position 0 0
#
# Block form, including workspace eligibility:
# output DP-3 {
#   default
#   workspaces 1|2|3|4|name*
#   position 0 0
# }
# Workspace patterns are case-sensitive; '*' matches any sequence. Numeric
# pattern 1 also matches names such as 1:web.
